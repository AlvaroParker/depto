{
	"name": "expenses",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.11.0",
	"scripts": {
		"init": "./scripts/init",
		"dev": "next dev",
		"build": "next build",
		"cf:build": "opennextjs-cloudflare build",
		"start": "next start",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typegen": "next typegen",
		"lint": "pnpm typegen && eslint .",
		"typecheck": "pnpm typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:bootstrap": "E2E_BOOTSTRAP=true playwright test tests/e2e/bootstrap.spec.ts --project=chromium",
		"auth:secret": "node scripts/generate-auth-secret.mjs",
		"db:migrate:local": "wrangler d1 migrations apply expenses-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply expenses-db --remote",
		"db:seed:local": "tsx scripts/seed-users.ts --local",
		"db:seed:remote": "tsx scripts/seed-users.ts --remote",
		"db:reset:local": "rm -rf .wrangler/state && pnpm db:migrate:local",
		"deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
		"deploy:cf": "opennextjs-cloudflare deploy",
		"upload": "pnpm cf:build && opennextjs-cloudflare upload",
		"preview": "pnpm cf:build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.9",
		"clsx": "^2.1.1",
		"lucide-react": "^1.23.0",
		"next": "16.2.6",
		"next-auth": "5.0.0-beta.31",
		"react": "^19.1.7",
		"react-dom": "^19.1.7",
		"tailwind-merge": "^3.6.0",
		"ts-results": "^3.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^20.19.43",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9",
		"eslint-config-next": "16.2.6",
		"jsdom": "^29.1.1",
		"miniflare": "^4.20260708.1",
		"prettier": "^3.9.4",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.0",
		"typescript": "^5.7.4",
		"vitest": "^4.1.10",
		"wrangler": "^4.110.0"
	}
}
